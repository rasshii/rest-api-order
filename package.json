{
  "name": "rest-api-order",
  "version": "0.0.0",
  "private": true,
  "description": "REST API 設計・実装ガイドのサンプルリポジトリ",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "redocly lint openapi/openapi.yaml --lint-config=error",
    "verify": "npm run typecheck && npm run test && npm run lint",
    "bundle": "redocly bundle openapi/openapi.yaml --output dist/openapi.yaml",
    "docs:build": "npm run bundle && redocly build-docs dist/openapi.yaml --output dist/docs/index.html",
    "docs:swagger": "npm run bundle && node tools/swagger-ui/server.ts"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "swagger-ui-dist": "5.34.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
